# Copy to .env (repo root). With NO keys set, the app runs in MOCK MODE: three fake providers,
# deterministic placeholder judgments, but the real pool / rate limiter / retries / quorum logic.

# ---- Database ----
# Local:  docker compose up -d mongo   (matches the default below)
# Cloud:  a free MongoDB Atlas cluster URI works too.
MONGODB_URI=mongodb://127.0.0.1:27017/build-or-not

# ---- Providers: set one or more. Two or more enables the "mixed" panel. ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_RPM=50

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_RPM=60

GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_RPM=60
# ---- Free providers (OpenAI-compatible). Leave *_MODEL empty to auto-pick a free model at startup. ----
# Groq: console.groq.com -> API Keys (gsk_...). Free: ~30 req/min, 1,000/day, but ~8k tokens/min.
GROQ_API_KEY=
# More free Groq keys for the free tier (e.g. from other Groq accounts you own). Separate with commas.
# Their limits add up: 3 keys ≈ 3x the questions at once. Broken keys are skipped at startup.
# Works the same for other providers: OPENROUTER_API_KEYS, GEMINI_API_KEYS, ...
GROQ_API_KEYS=
GROQ_MODEL=
GROQ_RPM=6
# OpenRouter: openrouter.ai -> Keys (sk-or-...). Free ":free" models: ~20 req/min, only ~50 req/day without credits.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_RPM=15
# OpenCode Zen: opencode.ai/zen. Free models end in "-free".
OPENCODE_API_KEY=
OPENCODE_MODEL=
OPENCODE_RPM=10

# Model names change often; set whatever cheap/fast model each provider currently offers.
# Keys are checked at startup (free, no tokens). After editing this file, restart the server.
# Optional: route through a gateway/proxy. For OpenAI-compatible providers include the version path,
# e.g. OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=

# ---- Panel ----
# Use only these providers even if other keys are set (comma-separated), e.g. PROVIDERS=groq
PROVIDERS=
# single = all 45 personas on one provider (PANEL_PROVIDER, default: first configured)
# mixed  = personas spread round-robin across every configured provider
PANEL_MODE=single
PANEL_PROVIDER=
# Max persona calls in flight across all providers (per-provider rate is limited by *_RPM)
PANEL_CONCURRENCY=8
# How persona calls are sent when an idea is submitted.
#   (empty)  measure each key's real limits and send as many at once as it allows (recommended)
#   true     send all 45 at once, whatever the limits say
#   false    fixed pacing: PANEL_CONCURRENCY in flight, ~10% of *_RPM per burst
PANEL_ALL_AT_ONCE=
# Pin one provider's burst, e.g. GROQ_BURST=5. *_RPM above also caps the measured rate when set.

# ---------- Public site ----------
# The keys above are the site's own: they power the FREE TIER, capped per visitor IP per day.
FREE_RUNS_PER_DAY=3
# When the site has no key, the free tier runs simulated models, capped separately.
SIM_RUNS_PER_DAY=20
# Visitors may paste their own key instead. It's used for their run only and never stored.
ALLOW_OWN_KEYS=true
# "Just type your idea": AI-written briefs per visitor per day (one small call each, same key as the run)
DRAFTS_PER_DAY=10
OWN_RUNS_PER_DAY=20
KEY_CHECKS_PER_HOUR=10
API_REQUESTS_PER_MINUTE=120
# Secret for hashing visitor IPs (raw IPs are never stored). Any long random string.
IP_HASH_SECRET=
# Unlocks the owner's stats page at /stats (visitors, referrers, runs). 16+ random characters.
# Leave empty to switch the stats page off.
ADMIN_TOKEN=
# How to find each visitor's real IP (for the 3-a-day limit). On Render nothing to set: the app
# reads Render's True-Client-IP header automatically. Elsewhere, behind your own Cloudflare, set
# CLIENT_IP_HEADER=cf-connecting-ip; behind another proxy, set TRUST_PROXY to the number of hops.
CLIENT_IP_HEADER=
TRUST_PROXY=0
# Only if the client is served from another origin than the API (not needed normally).
CORS_ORIGIN=
# Share of personas that must succeed before a verdict is published
PANEL_QUORUM=0.8

# Theme synthesis (one call per idea). Defaults to the panel provider; Anthropic defaults to Sonnet.
SYNTHESIS_PROVIDER=
SYNTHESIS_MODEL=

# ---- Resilience ----
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_MS=500
RETRY_MAX_MS=20000
REQUEST_TIMEOUT_MS=60000

# ---- Cost tracking: USD per 1M tokens [input, output] for models not in the built-in table ----
# MODEL_PRICES={"my-model":[0.5,1.5]}

# ---- Mock mode knobs (to watch retries / re-asks / partial failure without spending anything) ----
MOCK_LATENCY_MS=150
MOCK_FAILURE_RATE=0
MOCK_MALFORMED_RATE=0

PORT=4100

# ---- Accounts / sign-in (optional; see docs/SIGN-IN.md) ----
# Each option shows on the sign-in screen only when its keys are set.
# The site's public address: sign-in callbacks are PUBLIC_URL/api/auth/<provider>/callback.
PUBLIC_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Email codes. Locally, leave empty: the code is printed in the server log.
RESEND_API_KEY=
EMAIL_FROM=
