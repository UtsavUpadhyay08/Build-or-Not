# ------------------------------------------------------------------
# Never push these. Secrets go in your host's dashboard (Render →
# Environment), not in the repo.
# ------------------------------------------------------------------

# Secrets and local config
.env
**/.env
**/.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
credentials*.json
service-account*.json

# Dependencies (npm install recreates them)
node_modules/
**/node_modules/

# Build output (npm run build recreates it)
dist/
build/
**/dist/
*.tsbuildinfo
.vite/
client/.vite/

# Test and coverage output
coverage/
.nyc_output/
test-results/
playwright-report/
.vitest/

# Experiment data and reports (large, regenerated by `npm run eval`)
server/eval-data/
server/eval-reports/

# Local databases (docker compose volumes, FerretDB/SQLite files)
data/
mongo-data/
*.sqlite
*.sqlite3
*.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.eslintcache
.npm/
.turbo/

# Editors and IDEs (keep shared settings out; everyone has their own)
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS clutter
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# Scratch files
*.tmp
*.bak
*.orig
tmp/
